#!/usr/bin/env ruby
#MISE hide=true

require 'json'
require 'open3'
require 'set'

AGENTS = %w[claude-code cursor codex pi].freeze
SOURCES = [
  'civitaspo/dotfiles-private',
  'civitaspo/dotfiles',
  'https://github.com/cursor/plugins/tree/main/pstack',
  'DietrichGebert/ponytail',
  'backnotprop/plannotator/apps/skills/core',
  'backnotprop/plannotator/apps/skills/extra',
  'nanaism/yomiyasu',
  'herdrdev/herdr/skills/herdr',
  'mattpocock/skills'
].freeze

def capture(*command)
  output, status = Open3.capture2(*command)
  abort "Command failed: #{command.join(' ')}" unless status.success?
  output
rescue Errno::ENOENT
  abort "Command not found: #{command.first}"
end

def run(*command)
  abort "Command failed: #{command.join(' ')}" unless system(*command)
end

def names_from_source(source)
  output = capture('skills', 'add', source, '--list').gsub(/\e\[[0-?]*[ -\/]*[@-~]/, '')
  listing = output.split('Available Skills', 2)[1]
  names = listing ? listing.lines.map { |line| line[/^[^│]*│ {4}(\S.*\S|\S)\s*$/, 1] }.compact : []
  abort "No skills found in #{source}; refusing to reconcile." if names.empty?
  names.to_set
end

sources = SOURCES.map { |source| [source, names_from_source(source)] }
desired = sources.reduce(Set.new) { |names, (_, source_names)| names | source_names }
installed = JSON.parse(capture('skills', 'ls', '-g', '--json')).map { |skill| skill.fetch('name') }.to_set
add = desired - installed
remove = installed - desired - Set['rex']

add.sort.each { |name| puts "+ #{name}" }
remove.sort.each { |name| puts "- #{name}" }
if add.empty? && remove.empty?
  puts 'No skills to add or remove.'
else
  puts "#{add.size} to add, #{remove.size} to remove."
end

plan = ENV['SKILLS_RECONCILE'] == 'plan'
unless plan
  run('skills', 'remove', '-g', '-y', *remove.sort) unless remove.empty?
  run('skills', 'update', '-g', '-y')
  sources.each do |source, names|
    missing = (names & add).sort
    next if missing.empty?

    run('skills', 'add', source, '--skill', *missing, '-g', '-y', '-a', *AGENTS)
    add.subtract(missing)
  end
end

rex = ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).any? do |directory|
  path = File.join(directory.empty? ? '.' : directory, 'rex')
  File.file?(path) && File.executable?(path)
end
if rex
  command = ['rex', 'skill', 'setup']
  command << '--dry-run' if plan
  run(*command)
else
  warn 'rex is not on PATH; Rex skill setup skipped.'
end
