#!/usr/bin/env bash
#MISE description="Install global agent skills."
set -euo pipefail

agents=(claude-code cursor codex opencode pi)

add() {
  local source="$1"
  local -a cmd=(skills add "${source}" --skill '*' -g -y)
  local agent
  for agent in "${agents[@]}"; do
    cmd+=(-a "${agent}")
  done
  "${cmd[@]}"
}

add 'civitaspo/dotfiles-private'
add 'https://github.com/cursor/plugins/tree/main/pstack'
add 'DietrichGebert/ponytail'
add 'backnotprop/plannotator/apps/skills/core'
add 'backnotprop/plannotator/apps/skills/extra'
add 'nanaism/yomiyasu'
add 'herdrdev/herdr/skills/herdr'
add 'mattpocock/skills'

skills update -g -y
