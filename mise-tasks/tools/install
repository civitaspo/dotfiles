#!/usr/bin/env bash
#MISE hide=true
set -euo pipefail

# Use the normal global config so mise honors global-only settings in local
# config; fall back to the repository config before dotfiles are linked.
config_dir="${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}"
if [[ ! -f "$config_dir/config.toml" && -z "${MISE_GLOBAL_CONFIG_FILE:-}" ]]; then
  export MISE_GLOBAL_CONFIG_FILE="${MISE_PROJECT_ROOT:?}/config/mise/config.toml"
  export MISE_GLOBAL_CONFIG_ROOT="$MISE_PROJECT_ROOT/config/mise"
fi

configured_tools() {
  # The jq filter uses jq variables, not shell variables.
  # shellcheck disable=SC2016
  mise ls --current --json | mise exec -- jq -r 'to_entries[] | .key as $tool | .value[] | [($tool + "@" + .version), .install_path] | @tsv'
}

has_payload() {
  [[ -d "$1" ]] || return 1
  local files
  # Accept valid symlinks, including externally managed runtime directories.
  files="$(find "$1" \( -type f -o \( -type l -exec test -e {} \; \) \) -print -quit)" || exit 1
  [[ -n "$files" ]]
}

mise install
tools="$(configured_tools)"
while IFS=$'\t' read -r tool install_path; do
  [[ -n "$tool" ]] || continue
  if ! has_payload "$install_path"; then
    printf '[tools:install] repairing empty installation: %s\n' "$tool"
    mise install --force "$tool"
    if ! has_payload "$install_path"; then
      printf '[tools:install] %s is still empty after reinstall\n' "$tool" >&2
      exit 1
    fi
  fi
done <<<"$tools"
