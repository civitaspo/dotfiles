#!/usr/bin/env bash
#MISE description="Install Moshi agent hooks and a login LaunchAgent."

set -euo pipefail

moshi_hook="$(command -v moshi-hook || true)"

if [[ -z "${moshi_hook}" ]]; then
  printf '[setup:moshi-hook] moshi-hook is not available on PATH; run mise run tools\n' >&2
  exit 1
fi

printf '[setup:moshi-hook] installing agent hooks\n'
"${moshi_hook}" install

install_launch_agent() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0

  local mise_bin
  mise_bin="$(command -v mise || true)"
  if [[ -z "${mise_bin}" && -x "${HOME}/.local/bin/mise" ]]; then
    mise_bin="${HOME}/.local/bin/mise"
  fi
  if [[ -z "${mise_bin}" ]]; then
    printf '[setup:moshi-hook] mise not found; skip LaunchAgent\n' >&2
    return 0
  fi

  local label="app.getmoshi.hook"
  local plist_dir="${HOME}/Library/LaunchAgents"
  local plist="${plist_dir}/${label}.plist"
  local uid
  uid="$(id -u)"

  mkdir -p "${plist_dir}" "${HOME}/Library/Logs"
  cat >"${plist}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${mise_bin}</string>
    <string>exec</string>
    <string>--</string>
    <string>moshi-hook</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${HOME}/Library/Logs/moshi-hook.log</string>
  <key>StandardErrorPath</key>
  <string>${HOME}/Library/Logs/moshi-hook.log</string>
</dict>
</plist>
EOF

  if launchctl print "gui/${uid}/${label}" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/${uid}/${label}" || true
  else
    launchctl bootstrap "gui/${uid}" "${plist}" || true
  fi
}

install_launch_agent

if ! "${moshi_hook}" status --json | python3 -c 'import json, sys; raise SystemExit(0 if json.load(sys.stdin).get("paired") else 1)'; then
  printf '[setup:moshi-hook] pair this host from the Moshi app: moshi-hook pair --token <token>\n'
fi

printf '[setup:moshi-hook] moshi-hook ready\n'
