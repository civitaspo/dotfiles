#!/usr/bin/env bash
#MISE description="Install Herdr plugins for terminal-browser and annotate."

set -euo pipefail

# Keep the official installer from launching `terminal-browser setup`
# mid-install.
export TERMINAL_BROWSER_SKIP_SETUP=1
# nix-darwin's GNU tar extracts the tarball's AppleDouble entries as literal
# `._*` files, which breaks the notarized app's code seal and makes
# Gatekeeper report it as damaged. macOS bsdtar restores them as xattrs.
export PATH="/usr/bin:${PATH}"

herdr_bin="$(command -v herdr || true)"

if [[ -z "${herdr_bin}" ]]; then
  printf '[setup:herdr] herdr is not available on PATH\n' >&2
  exit 1
fi

app="${XDG_DATA_HOME:-${HOME}/.local/share}/terminal-browser/app"

terminal_browser_is_valid() {
  [[ -x "${app}/bin/terminal-browser" ]] &&
    codesign --verify --deep --strict "${app}/electron/terminal-browser.app" >/dev/null 2>&1
}

install_terminal_browser() {
  if terminal_browser_is_valid; then
    printf '[setup:herdr] terminal-browser already installed\n'
    return 0
  fi

  printf '[setup:herdr] installing terminal-browser via official installer\n'
  curl -fsSL https://terminal-browser.sh/install | bash

  if ! terminal_browser_is_valid; then
    printf '[setup:herdr] terminal-browser install at %s failed code signature verification\n' "${app}" >&2
    exit 1
  fi
}

plugin_is_installed() {
  local plugin_id="$1"
  "${herdr_bin}" plugin list --json 2>/dev/null | python3 -c '
import json, sys

plugin_id = sys.argv[1]
try:
    data = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)

plugins = data.get("result", {}).get("plugins", [])
raise SystemExit(0 if any(plugin.get("id") == plugin_id for plugin in plugins) else 1)
' "${plugin_id}"
}

install_plugin() {
  local spec="$1"
  local plugin_id="$2"

  if plugin_is_installed "${plugin_id}"; then
    printf '[setup:herdr] plugin %s already installed\n' "${plugin_id}"
    return 0
  fi

  printf '[setup:herdr] installing %s\n' "${spec}"
  "${herdr_bin}" plugin install "${spec}" --yes
}

install_plugin "zenbu-labs/terminal-browser/herdr-plugin" "zenbu-labs.terminal-browser"
install_plugin "plannotator/herdr-annotate" "annotate"
# The terminal-browser plugin build reruns the official installer; repair it
# afterwards in case that ran with GNU tar.
install_terminal_browser

config="${XDG_CONFIG_HOME:-${HOME}/.config}/herdr/config.toml"
if [[ -f "${config}" ]]; then
  "${herdr_bin}" config check
fi

printf '[setup:herdr] herdr plugins ready\n'
