#!/usr/bin/env bash
#MISE description="Activate nix-darwin and home-manager."
set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

# Install replacements before activating the system without the Nix packages.
MISE_GLOBAL_CONFIG_FILE="$MISE_PROJECT_ROOT/config/mise/config.toml" \
  MISE_GLOBAL_CONFIG_ROOT="$MISE_PROJECT_ROOT/config/mise" \
  mise install python node go aqua:hashicorp/terraform aqua:F1bonacc1/process-compose aqua:grafana/k6

onepassword_socket="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [[ -S "$onepassword_socket" ]]; then
  export SSH_AUTH_SOCK="$onepassword_socket"
fi

if command -v darwin-rebuild >/dev/null 2>&1; then
  darwin-rebuild build --flake ".#aarch64-darwin"
else
  nix build ".#darwinConfigurations.aarch64-darwin.system"
fi

# Move the public links before home-manager cleans up its old generation.
public_root="$HOME/src/github.com/civitaspo/dotfiles"
if [[ ! -d "$public_root/home" || ! "$public_root/home" -ef "$MISE_PROJECT_ROOT/home" || ! -d "$public_root/config" || ! "$public_root/config" -ef "$MISE_PROJECT_ROOT/config" ]]; then
  printf 'Run switch from the checkout configured in the public dotfile groups.\n' >&2
  exit 1
fi
mise dotfiles apply --yes "$HOME" "$HOME/.config"
while IFS= read -r -d '' path; do
  if [[ "$path" == config/* ]]; then
    target="$HOME/.config/${path#config/}"
  else
    target="$HOME/${path#home/}"
  fi
  if [[ ! -L "$target" || ! "$target" -ef "$MISE_PROJECT_ROOT/$path" ]]; then
    printf 'Public dotfile was not linked: %s\n' "$path" >&2
    exit 1
  fi
done < <(git ls-files -z home config)

sudo nix-env -p /nix/var/nix/profiles/system --set ./result
sudo ./result/activate
rm -f ./result

mise bootstrap macos defaults apply --yes
./mise-tasks/mcp/sync
