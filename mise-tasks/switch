#!/usr/bin/env bash
#MISE description="Activate nix-darwin and apply dotfiles."
set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

# Install replacements before activating the system without the Nix packages.
MISE_GLOBAL_CONFIG_FILE="$MISE_PROJECT_ROOT/config/mise/config.toml" \
  MISE_GLOBAL_CONFIG_ROOT="$MISE_PROJECT_ROOT/config/mise" \
  mise install python node go aqua:hashicorp/terraform aqua:F1bonacc1/process-compose aqua:grafana/k6 aqua:git-lfs/git-lfs aqua:stunnel/static-curl aqua:mas-cli/mas http:zsh-autosuggestions http:zsh-syntax-highlighting http:zsh-completions

onepassword_socket="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [[ -S "$onepassword_socket" ]]; then
  export SSH_AUTH_SOCK="$onepassword_socket"
fi

if command -v darwin-rebuild >/dev/null 2>&1; then
  darwin-rebuild build --flake ".#aarch64-darwin"
else
  nix build ".#darwinConfigurations.aarch64-darwin.system"
fi

# Transfer links before activating the configuration without home-manager.
./mise-tasks/dotfiles-apply

sudo ./mise-tasks/setup/activate-system ./result/activate /etc/pam.d/sudo /etc/pam.d/sudo_local
rm -f ./result

./mise-tasks/setup/system-settings
./mise-tasks/setup/timezone
mise bootstrap macos defaults apply --yes
./mise-tasks/mcp/sync
