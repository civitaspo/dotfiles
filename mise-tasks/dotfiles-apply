#!/usr/bin/env bash
#MISE hide=true
set -euo pipefail

public_root="$HOME/src/github.com/civitaspo/dotfiles"
private_root="$HOME/src/github.com/civitaspo/dotfiles-private"
if [[ ! -d "$public_root/home" || ! "$public_root/home" -ef "$MISE_PROJECT_ROOT/home" || ! -d "$public_root/config" || ! "$public_root/config" -ef "$MISE_PROJECT_ROOT/config" ]]; then
  printf 'Run mise run dotfiles from the checkout configured in the public dotfile groups.\n' >&2
  exit 1
fi
if [[ ! -f "$private_root/mise.toml" || ! -d "$private_root/home" || ! -d "$private_root/config" ]]; then
  printf 'Clone and update the private dotfiles checkout before running mise run dotfiles.\n' >&2
  exit 1
fi
private_paths=()
while IFS= read -r -d '' private_path; do
  private_paths+=("$private_path")
done < <(git -C "$private_root" ls-files -z home config)

while IFS= read -r -d '' public_path; do
  case "$public_path" in
    home/*) public_target=${public_path#home/} ;;
    config/*) public_target=.config/${public_path#config/} ;;
  esac
  for private_path in "${private_paths[@]}"; do
    case "$private_path" in
      config/mise/*) continue ;;
      home/*) private_target=${private_path#home/} ;;
      config/*) private_target=.config/${private_path#config/} ;;
    esac
    if [[ "$public_target" == "$private_target" || "$public_target" == "$private_target/"* || "$private_target" == "$public_target/"* ]]; then
      printf 'Public and private dotfile targets overlap: %s and %s\n' "$public_path" "$private_path" >&2
      exit 1
    fi
  done
done < <(git -C "$MISE_PROJECT_ROOT" ls-files -z home config)

/bin/bash "$MISE_PROJECT_ROOT/mise-tasks/check/private"
mise dotfiles apply --yes "$HOME" "$HOME/.config"
MISE_TRUSTED_CONFIG_PATHS="$private_root${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}" \
  mise -C "$private_root" dotfiles apply --yes "$HOME" "$HOME/.config" "$HOME/.cursor/mcp.json"

for root in "$MISE_PROJECT_ROOT" "$private_root"; do
  while IFS= read -r -d '' path; do
    case "$path" in
      config/mise/*) [[ "$root" == "$private_root" ]] && continue ;;
    esac
    if [[ "$path" == config/* ]]; then
      target="$HOME/.config/${path#config/}"
    else
      target="$HOME/${path#home/}"
    fi
    if [[ ! -L "$target" || ! "$target" -ef "$root/$path" ]]; then
      printf 'A managed dotfile was not linked; activation stopped.\n' >&2
      exit 1
    fi
  done < <(git -C "$root" ls-files -z home config)
done
if [[ ! -L "$HOME/.cursor/mcp.json" || ! "$HOME/.cursor/mcp.json" -ef "$private_root/config/dotfiles/mcp.json" ]]; then
  printf 'Cursor MCP configuration was not linked; activation stopped.\n' >&2
  exit 1
fi
