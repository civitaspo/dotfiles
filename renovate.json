{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am every weekday"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "vulnerabilityFixStrategy": "highest"
  },
  "branchPrefix": "renovate/",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "nix": {
    "enabled": true
  },
  "mise": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am every weekday"]
  },
  "customDatasources": {
    "1password-cli": {
      "defaultRegistryUrlTemplate": "https://formulae.brew.sh/api/cask/1password-cli.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": version}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump pinned aqua:1password/cli in mise config and lock (aqua HTTP packages have no version list).",
      "managerFilePatterns": [
        "/(^|/)config/mise/config\\.toml$/",
        "/(^|/)config/mise/mise\\.lock$/"
      ],
      "matchStrings": [
        "\"aqua:1password/cli\"\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "\\[\\[tools\\.\"aqua:1password/cli\"\\]\\]\\nversion = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "pkg/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/op_darwin_arm64_v\\d+\\.\\d+\\.\\d+\\.zip",
        "op_darwin_arm64_v(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.zip"
      ],
      "depNameTemplate": "1password-cli",
      "datasourceTemplate": "custom.1password-cli",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Private flake input; Renovate cannot look up SSH git refs.",
      "matchManagers": ["nix"],
      "matchDepNames": ["dotfiles-private"],
      "enabled": false
    },
    {
      "description": "1password-cli is updated by the custom manager; mise cannot resolve aqua HTTP versions.",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:1password/cli"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions updates together.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge securefix-server reusable workflow pin bumps",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["civitaspo/securefix-server/**"],
      "automerge": true
    },
    {
      "description": "Automerge non-major updates (minor, patch, pin, digest)",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Group Nix flake input updates together.",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs"
    },
    {
      "description": "Group mise tool updates together.",
      "matchManagers": ["mise", "custom.regex"],
      "groupName": "mise tools"
    }
  ]
}
