{
  "automergeType": "pr-comment",
  "automergeComment": "/merge",
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am every weekday"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "vulnerabilityFixStrategy": "highest"
  },
  "branchPrefix": "renovate/",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "nix": {
    "enabled": true
  },
  "mise": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am every weekday"]
  },
  "customDatasources": {
    "1password-cli": {
      "defaultRegistryUrlTemplate": "https://formulae.brew.sh/api/cask/1password-cli.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": version, \"digest\": sha256}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump pinned aqua:1password/cli in mise config (aqua HTTP packages have no version list).",
      "managerFilePatterns": [
        "/(^|/)config/mise/config\\.toml$/"
      ],
      "matchStrings": [
        "\"aqua:1password/cli\"\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "1password-cli",
      "datasourceTemplate": "custom.1password-cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Rewrite the 1Password CLI lock entry, including its archive checksum. A first-match version replace leaves the previous zip's SHA-256 in place.",
      "managerFilePatterns": [
        "/(^|/)config/mise/mise\\.lock$/"
      ],
      "matchStrings": [
        "\\[\\[tools\\.\"aqua:1password/cli\"\\]\\]\\nversion = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\nbackend = \"aqua:1password/cli\"\\n\\n\\[tools\\.\"aqua:1password/cli\"\\.\"platforms\\.macos-arm64\"\\]\\nchecksum = \"sha256:(?<currentDigest>[a-f0-9]{64})\"\\nurl = \"https://cache\\.agilebits\\.com/dist/1P/op2/pkg/v\\d+\\.\\d+\\.\\d+/op_darwin_arm64_v\\d+\\.\\d+\\.\\d+\\.zip\""
      ],
      "autoReplaceStringTemplate": "[[tools.\"aqua:1password/cli\"]]\nversion = \"{{{newValue}}}\"\nbackend = \"aqua:1password/cli\"\n\n[tools.\"aqua:1password/cli\".\"platforms.macos-arm64\"]\nchecksum = \"sha256:{{{newDigest}}}\"\nurl = \"https://cache.agilebits.com/dist/1P/op2/pkg/v{{{newValue}}}/op_darwin_arm64_v{{{newValue}}}.zip\"",
      "depNameTemplate": "1password-cli",
      "datasourceTemplate": "custom.1password-cli",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Private flake input; Renovate cannot look up SSH git refs.",
      "matchManagers": ["nix"],
      "matchDepNames": ["dotfiles-private"],
      "enabled": false
    },
    {
      "description": "1password-cli is updated by the custom manager; mise cannot resolve aqua HTTP versions.",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:1password/cli"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions updates together.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge csm-ci-actions reusable workflow pin bumps",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["civitaspo/csm-ci-actions/**"],
      "automerge": true
    },
    {
      "description": "Automerge non-major updates (minor, patch, pin, digest)",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Group Nix flake input updates together.",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs"
    },
    {
      "description": "Group mise tool updates together.",
      "matchManagers": ["mise", "custom.regex"],
      "groupName": "mise tools"
    },
    {
      "description": "OpenCode v2 runs its postinstall script via allow_builds; review each bump in its own PR.",
      "matchManagers": ["mise"],
      "matchDepNames": ["npm:@opencode/cli"],
      "groupName": "opencode",
      "automerge": false
    },
    {
      "description": "The skills CLI clones repositories into the home directory; review each bump.",
      "matchManagers": ["mise"],
      "matchDepNames": ["npm:skills"],
      "groupName": "skills",
      "automerge": false
    }
  ]
}
